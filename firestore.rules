rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    // isAdmin is only ever true if it was set directly in the Firebase
    // Console — see the create/update rules on /users/{uid} below, which
    // never let a client set or change this field on any account, their
    // own included. Costs one extra document read wherever it's used.
    // Both use .get(field, default) and exists(): reading a field that isn't
    // on the doc (almost every profile has no isAdmin/suspended) is an
    // ERROR in rules, and an error means deny — which silently blocked every
    // normal user from posting a listing.
    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }
    function isSuspended(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.get('suspended', false) == true;
    }
    // True if `ownerUid` has blocked `uid`. Enforced on every way one user
    // can reach another (new chat, message, visit request, notification),
    // so blocking isn't just hidden in the blocker's UI.
    function isBlockedBy(ownerUid, uid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/blocked/$(uid));
    }

    // ---- reports ----
    // Doc id is fixed to reporter_type_target, so each user can file at most
    // one report per listing/user: a repeat is an update, which only admins
    // may do. Only admins can read reports — reporters are never exposed.
    function validReport(reportId) {
      let d = request.resource.data;
      return d.reporterId == request.auth.uid
          && d.targetType in ['listing','user']
          && d.targetId is string && d.targetId.size() > 0 && d.targetId.size() <= 200
          && reportId == request.auth.uid + '_' + d.targetType + '_' + d.targetId
          && d.reason in ['fake','duplicate','wrong_price','unavailable','misleading','scam','inappropriate','other']
          && (!('details' in d) || (d.details is string && d.details.size() <= 500))
          && (!('targetTitle' in d) || (d.targetTitle is string && d.targetTitle.size() <= 120))
          && (!('targetOwnerId' in d) || (d.targetOwnerId is string && d.targetOwnerId.size() <= 200))
          && d.status == 'pending'
          && d.createdAt == request.time
          && d.keys().hasOnly(['reporterId','targetType','targetId','targetTitle','targetOwnerId','reason','details','status','createdAt']);
    }

    // ---- listings ----
    // Field-shape validation added: without this, any signed-in user (trivial
    // to become one via phone OTP) could write arbitrary field types/sizes,
    // inflating read costs for every visitor and pointing `photos` at
    // non-Cloudinary URLs used as passive tracking pixels against every viewer.
    function validListing() {
      let d = request.resource.data;
      return d.title is string && d.title.size() <= 120
          && (!('titleHi' in d) || (d.titleHi is string && d.titleHi.size() <= 120))
          && d.location is string && d.location.size() <= 120
          && (!('area' in d) || (d.area is string && d.area.size() <= 120))
          && d.category in ['rent','buy','library']
          && d.price is number && d.price >= 0 && d.price <= 100000000
          && (!('bathrooms' in d) || (d.bathrooms is number && d.bathrooms >= 0 && d.bathrooms <= 50))
          && (!('ownerName' in d) || (d.ownerName is string && d.ownerName.size() <= 80))
          && (!('ownerPicture' in d) || (d.ownerPicture is string && d.ownerPicture.size() <= 500))
          && (!('phone' in d) || (d.phone is string && d.phone.size() <= 20))
          && (!('bio' in d) || (d.bio is string && d.bio.size() <= 300))
          // Note: Firestore rules can't loop over list elements, so this caps
          // the count but does NOT verify each URL is actually a Cloudinary
          // URL. An attacker can still point a photo at an arbitrary host as
          // a tracking pixel (see audit finding). Closing that fully requires
          // moving uploads behind a signed, server-verified flow.
          && (!('photos' in d) || (d.photos is list && d.photos.size() <= 10))
          && (!('amenities' in d) || (d.amenities is list && d.amenities.size() <= 30))
          && (!('docs' in d) || (d.docs is list && d.docs.size() <= 20))
          && (!('deposit' in d) || (d.deposit is number && d.deposit >= 0 && d.deposit <= 100000000))
          && (!('negotiable' in d) || d.negotiable is bool)
          && (!('status' in d) || d.status in ['available','rented','sold','unavailable'])
          && (!('updatedAt' in d) || (d.updatedAt is string && d.updatedAt.size() <= 40));
    }

    // ---- saved/shortlisted properties ----
    // A small denormalized snapshot (not just the listing id) so "Saved
    // Properties" still shows something if the listing is later deleted,
    // matching the ownerName/ownerPicture denormalization already used on
    // listings themselves.
    function validSaved() {
      let d = request.resource.data;
      return d.listingId is string && d.listingId.size() <= 200
          && d.title is string && d.title.size() <= 120
          && d.price is number && d.price >= 0 && d.price <= 100000000
          && d.category is string && d.category.size() <= 20
          && (!('roomType' in d) || (d.roomType is string && d.roomType.size() <= 20))
          && d.location is string && d.location.size() <= 120
          && (!('photo' in d) || (d.photo is string && d.photo.size() <= 500));
    }

    // ---- schedule visit ----
    function validVisitFields() {
      let d = request.resource.data;
      return (!('date' in d) || (d.date is string && d.date.size() <= 20))
          && (!('time' in d) || (d.time is string && d.time.size() <= 20))
          && (!('message' in d) || (d.message is string && d.message.size() <= 300))
          && (!('status' in d) || d.status in ['pending','confirmed','rejected','rescheduled','completed','cancelled'])
          && (!('proposedDate' in d) || (d.proposedDate is string && d.proposedDate.size() <= 20))
          && (!('proposedTime' in d) || (d.proposedTime is string && d.proposedTime.size() <= 20));
    }

    // ---- in-app notifications ----
    // Written by the OTHER party to an event (e.g. a seeker requesting a
    // visit writes into the owner's notifications subcollection), so create
    // can't be restricted to "only the subcollection owner" the way saved/
    // is — it's the same cross-user-write trust model already accepted for
    // /chats/{chatId} creation. Kept narrow: sender is always attributable
    // (senderId must match the caller), fields are tightly size-capped, and
    // once created only the recipient can touch it, and only to flip `read`.
    function validNotification() {
      let d = request.resource.data;
      return d.type is string && d.type.size() <= 40
          && d.title is string && d.title.size() <= 120
          && d.body is string && d.body.size() <= 300
          && d.read == false
          && d.senderId is string
          && (!('link' in d) || d.link is map);
    }

    match /listings/{id} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && !isSuspended(request.auth.uid)
                    && validListing();
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId // can't reassign to someone else
          && validListing())
        // Admin can pull a listing out of Browse (via status) without deleting
        // it outright — used when suspending a user — but can't touch its
        // actual content (title/price/photos/etc), same restraint as the
        // admin branch on /users/{uid} below.
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['available','rented','sold','unavailable'])
      );
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /users/{uid} {
      // nothing in the app currently reads another user's profile directly — listings already carry
      // their own ownerName/phone — so the correct rule today is self-only. If you later build a
      // public "view owner" page, expose a separate, smaller `publicProfiles` collection instead of
      // reopening this one.
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Only an admin can list every profile (powers the Admin Dashboard's
      // user list) — everyone else stays self-read-only, as before.
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['owner','seeker'] // 'admin' can never be self-assigned, even at signup
                    && !('isAdmin' in request.resource.data)
                    && !('suspended' in request.resource.data);
      // Self-update keeps the existing shape checks and can never touch
      // isAdmin. A separate admin-only branch can flip `suspended` on ANY
      // account (never their own) but nothing else — this is the entire
      // moderation surface an admin has over another user's profile.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid
          && request.resource.data.get('role', '') == resource.data.get('role', '') // role fixed at creation
          // Neither flag can be changed by the account itself — otherwise a
          // suspended user could just write suspended:false on their own doc.
          && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
          && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
          && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300)))
        || (isAdmin() && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended'])
          && request.resource.data.suspended is bool)
      );
      // Account deletion: users can delete their own profile — except a
      // suspended user, who could otherwise delete the doc and re-create it
      // without the suspended flag. (The app scrubs a suspended user's
      // personal details via a normal self-update instead.)
      allow delete: if isSignedIn() && request.auth.uid == uid && !isSuspended(uid);

      match /saved/{listingId} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid && validSaved();
      }

      match /notifications/{notifId} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid && validNotification()
                      && !isBlockedBy(uid, request.auth.uid);
      }

      // Users this account has blocked. Only the owner can see or change
      // the list; other users' requests are checked against it via
      // isBlockedBy(), which never reveals the list to them.
      match /blocked/{blockedUid} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn() && request.auth.uid == uid && blockedUid != uid
                      && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80));
      }
    }

    match /visits/{visitId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.seekerId || request.auth.uid == resource.data.listingOwnerId);
      allow create: if isSignedIn()
                    && request.resource.data.seekerId == request.auth.uid
                    && request.resource.data.listingOwnerId is string
                    && request.resource.data.listingOwnerId != request.auth.uid // can't request a visit to your own listing
                    && request.resource.data.listingId is string && request.resource.data.listingId.size() <= 200
                    && request.resource.data.listingTitle is string && request.resource.data.listingTitle.size() <= 120
                    && request.resource.data.seekerName is string && request.resource.data.seekerName.size() <= 80
                    && request.resource.data.date is string && request.resource.data.date.size() <= 20
                    && request.resource.data.time is string && request.resource.data.time.size() <= 20
                    && request.resource.data.status == 'pending'
                    && validVisitFields()
                    && !isBlockedBy(request.resource.data.listingOwnerId, request.auth.uid);
      // Only the two fixed participants can update, and only the two of
      // them — identity fields (who/which listing) are frozen post-create,
      // same pattern as /chats/{chatId}.
      allow update: if isSignedIn()
                    && (request.auth.uid == resource.data.seekerId || request.auth.uid == resource.data.listingOwnerId)
                    && request.resource.data.seekerId == resource.data.seekerId
                    && request.resource.data.listingOwnerId == resource.data.listingOwnerId
                    && request.resource.data.listingId == resource.data.listingId
                    && request.resource.data.listingTitle == resource.data.listingTitle
                    && request.resource.data.seekerName == resource.data.seekerName
                    && validVisitFields()
                    // A blocked party can't keep poking the blocker through
                    // an old visit (reschedules, status flips).
                    && !isBlockedBy(resource.data.seekerId, request.auth.uid)
                    && !isBlockedBy(resource.data.listingOwnerId, request.auth.uid);
      allow delete: if false;
    }

    // A chat's create had no shape checks at all — any signed-in user could
    // write arbitrarily large listingTitle/names fields into a doc the
    // other participant is forced to load every time their inbox opens.
    function validChat() {
      let d = request.resource.data;
      return d.participants is list && d.participants.size() == 2
          && d.listingId is string && d.listingId.size() <= 200
          && d.listingTitle is string && d.listingTitle.size() <= 120
          && d.names is map
          && (!('lastMessage' in d) || (d.lastMessage is string && d.lastMessage.size() <= 2000));
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && validReport(reportId);
      // A reporter may check their OWN report id (to tell "already
      // reported" apart from a real error). A missing doc reveals nothing.
      allow get: if isSignedIn() && (resource == null || resource.data.reporterId == request.auth.uid);
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])
                    && request.resource.data.status in ['pending','reviewing','resolved','rejected'];
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && resource != null && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants && validChat()
                    && !isBlockedBy(request.resource.data.participants[0], request.auth.uid)
                    && !isBlockedBy(request.resource.data.participants[1], request.auth.uid);
      // Previously only `participants` was locked, which let either side rewrite
      // `listingTitle`/`names` after creation — e.g. spoofing the other
      // participant's displayed name inside the chat UI. Now every field except
      // lastMessage/lastMessageAt is frozen post-creation.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lastMessage','lastMessageAt'])
                    && (!('lastMessage' in request.resource.data) ||
                        (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000))
                    // Otherwise a blocked user could still push text into the
                    // blocker's inbox preview via lastMessage.
                    && !isBlockedBy(resource.data.participants[0], request.auth.uid)
                    && !isBlockedBy(resource.data.participants[1], request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                    && request.resource.data.senderId == request.auth.uid // can't forge who sent it
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000
                    // Neither participant may have blocked the sender (the
                    // sender's own list never contains themselves).
                    && !isBlockedBy(get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0], request.auth.uid)
                    && !isBlockedBy(get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1], request.auth.uid);
        // Only the recipient (never the sender) can touch a message after
        // it's created, and only to flip seenAt — a read receipt, not
        // editable content. The sender can delete their own message, but
        // only before seenAt exists: once the other person has actually
        // seen it, it's permanent — that's the whole point of the receipt.
        allow update: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                    && request.auth.uid != resource.data.senderId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']);
        allow delete: if isSignedIn()
                    && resource.data.senderId == request.auth.uid
                    && !('seenAt' in resource.data);
      }
    }
  }
}
