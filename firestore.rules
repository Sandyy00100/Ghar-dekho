rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // ---- listings ----
    // Field-shape validation added: without this, any signed-in user (trivial
    // to become one via phone OTP) could write arbitrary field types/sizes,
    // inflating read costs for every visitor and pointing `photos` at
    // non-Cloudinary URLs used as passive tracking pixels against every viewer.
    function validListing() {
      let d = request.resource.data;
      return d.title is string && d.title.size() <= 120
          && (!('titleHi' in d) || (d.titleHi is string && d.titleHi.size() <= 120))
          && d.location is string && d.location.size() <= 120
          && (!('area' in d) || (d.area is string && d.area.size() <= 120))
          && d.category in ['rent','buy','library']
          && d.price is number && d.price >= 0 && d.price <= 100000000
          && (!('bathrooms' in d) || (d.bathrooms is number && d.bathrooms >= 0 && d.bathrooms <= 50))
          && (!('ownerName' in d) || (d.ownerName is string && d.ownerName.size() <= 80))
          && (!('phone' in d) || (d.phone is string && d.phone.size() <= 20))
          && (!('bio' in d) || (d.bio is string && d.bio.size() <= 300))
          // Note: Firestore rules can't loop over list elements, so this caps
          // the count but does NOT verify each URL is actually a Cloudinary
          // URL. An attacker can still point a photo at an arbitrary host as
          // a tracking pixel (see audit finding). Closing that fully requires
          // moving uploads behind a signed, server-verified flow.
          && (!('photos' in d) || (d.photos is list && d.photos.size() <= 10))
          && (!('amenities' in d) || (d.amenities is list && d.amenities.size() <= 30))
          && (!('docs' in d) || (d.docs is list && d.docs.size() <= 20));
    }

    match /listings/{id} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && validListing();
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId // can't reassign to someone else
                    && validListing();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      // nothing in the app currently reads another user's profile directly — listings already carry
      // their own ownerName/phone — so the correct rule today is self-only. If you later build a
      // public "view owner" page, expose a separate, smaller `publicProfiles` collection instead of
      // reopening this one.
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role // role fixed at creation
                    && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 80))
                    && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300));
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && resource != null && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      // Previously only `participants` was locked, which let either side rewrite
      // `listingTitle`/`names` after creation — e.g. spoofing the other
      // participant's displayed name inside the chat UI. Now every field except
      // lastMessage/lastMessageAt is frozen post-creation.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lastMessage','lastMessageAt'])
                    && (!('lastMessage' in request.resource.data) ||
                        (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000));

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                    && request.resource.data.senderId == request.auth.uid // can't forge who sent it
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }
  }
}
